<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Tools on The Developer Log of lingyin</title><link>https://microtears.github.io/tool/</link><description>Recent content in Tools on The Developer Log of lingyin</description><generator>Hugo</generator><language>en-us</language><atom:link href="https://microtears.github.io/tool/index.xml" rel="self" type="application/rss+xml"/><item><title>Counter</title><link>https://microtears.github.io/tool/counter/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://microtears.github.io/tool/counter/</guid><description>&lt;div class="page"&gt;&#10; &lt;article class="post"&gt;&#10; &lt;div class="post-content"&gt;&#10; &lt;p&gt;&#10; 这是一个简单的浏览器计数器页面。使用按钮调整数值，并自动保存到本地存储，刷新后仍可保留当前计数。&#10; &lt;/p&gt;&#10;&#10; &lt;div class="counter-card"&gt;&#10; &lt;div class="counter-value" id="counterValue" aria-live="polite"&gt;0&lt;/div&gt;&#10; &lt;div class="counter-buttons"&gt;&#10; &lt;button type="button" id="decrementButton" aria-label="减少计数"&gt;-&lt;/button&gt;&#10; &lt;button type="button" id="resetButton" aria-label="重置计数"&gt;重置&lt;/button&gt;&#10; &lt;button type="button" id="incrementButton" aria-label="增加计数"&gt;+&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&#10; &lt;p&gt;支持键盘操作：使用方向键、+/- 以及 R 键修改计数。&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10;&lt;/div&gt;&#10;&#10;&lt;script&gt;&#10; (() =&gt; {&#10; const storageKey = "counter-page-value";&#10; const valueEl = document.getElementById("counterValue");&#10; const decrementButton = document.getElementById("decrementButton");&#10; const resetButton = document.getElementById("resetButton");&#10; const incrementButton = document.getElementById("incrementButton");&#10;&#10; const parseValue = (value) =&gt; {&#10; const num = Number(value);&#10; return Number.isFinite(num) ? num : 0;&#10; };&#10;&#10; const loadValue = () =&gt; {&#10; try {&#10; const stored = window.localStorage.getItem(storageKey);&#10; return parseValue(stored);&#10; } catch (error) {&#10; return 0;&#10; }&#10; };&#10;&#10; const saveValue = (value) =&gt; {&#10; try {&#10; window.localStorage.setItem(storageKey, String(value));&#10; } catch (error) {&#10; // ignore storage errors&#10; }&#10; };&#10;&#10; let counter = loadValue();&#10;&#10; const render = () =&gt; {&#10; valueEl.textContent = String(counter);&#10; };&#10;&#10; const update = (next) =&gt; {&#10; counter = next;&#10; saveValue(counter);&#10; render();&#10; };&#10;&#10; decrementButton.addEventListener("click", () =&gt; update(counter - 1));&#10; incrementButton.addEventListener("click", () =&gt; update(counter + 1));&#10; resetButton.addEventListener("click", () =&gt; update(0));&#10;&#10; window.addEventListener("keydown", (event) =&gt; {&#10; if (event.target instanceof HTMLButtonElement || event.target instanceof HTMLInputElement) {&#10; return;&#10; }&#10;&#10; switch (event.key) {&#10; case "ArrowUp":&#10; case "+":&#10; case "=":&#10; update(counter + 1);&#10; event.preventDefault();&#10; break;&#10; case "ArrowDown":&#10; case "-":&#10; update(counter - 1);&#10; event.preventDefault();&#10; break;&#10; case "r":&#10; case "R":&#10; update(0);&#10; event.preventDefault();&#10; break;&#10; }&#10; });&#10;&#10; render();&#10; })();&#10;&lt;/script&gt;&#10;&#10;&lt;style&gt;&#10; .counter-card {&#10; display: flex;&#10; flex-direction: column;&#10; gap: 1rem;&#10; margin-top: 1.4rem;&#10; padding: 1.4rem;&#10; border: 1px solid #c7c7c7;&#10; border-radius: 16px;&#10; background: #f8f9ff;&#10; }&#10;&#10; .counter-value {&#10; font-size: 4rem;&#10; font-weight: 700;&#10; text-align: center;&#10; color: #202124;&#10; }&#10;&#10; .counter-buttons {&#10; display: grid;&#10; grid-template-columns: repeat(3, minmax(0, 1fr));&#10; gap: 0.75rem;&#10; }&#10;&#10; .counter-buttons button {&#10; padding: 1rem 1.1rem;&#10; font-size: 1.1rem;&#10; font-weight: 600;&#10; border: 1px solid #a3c9ff;&#10; border-radius: 12px;&#10; background: white;&#10; color: #222;&#10; cursor: pointer;&#10; transition:&#10; transform 0.15s ease,&#10; background-color 0.15s ease;&#10; }&#10;&#10; .counter-buttons button:hover,&#10; .counter-buttons button:focus-visible {&#10; background: #e6f0ff;&#10; transform: translateY(-1px);&#10; }&#10;&#10; .counter-buttons button:active {&#10; transform: translateY(0);&#10; }&#10;&#10; @media (max-width: 520px) {&#10; .counter-card {&#10; padding: 1rem;&#10; }&#10;&#10; .counter-value {&#10; font-size: 3rem;&#10; }&#10; }&#10;&lt;/style&gt;</description></item></channel></rss>